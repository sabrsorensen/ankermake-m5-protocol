# ============================================================
# ankerctl – Environment Variables
# ============================================================
# Copy this file to .env and fill in the required values.
# Docker Compose picks it up automatically via env_file.
#
# Legend:
#   [REQUIRED] – must be set or something will not work
#   [RECOMMENDED] – should be set for sensible operation
#   [OPTIONAL] – may be omitted; a sensible default will be used
# ============================================================


# ============================================================
# REQUIRED
# ============================================================

# [REQUIRED] IP address the web server listens on.
# With host networking, set this to the host's LAN IP.
FLASK_HOST=192.168.1.x

# [REQUIRED] Persistent secret key for browser sessions.
# Without this value, a new key is generated every time the
# container restarts -> all browser sessions become invalid and
# saving in the UI fails with "Unauthorized".
# Generate once: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=REPLACE_WITH_GENERATED_KEY


# ============================================================
# RECOMMENDED
# ============================================================

# [RECOMMENDED] API key for write operations (POST/DELETE).
# Without this key, anyone on the network can change settings and
# start prints. After setting it, open this once in your browser:
# http://<FLASK_HOST>:<FLASK_PORT>/?apikey=<WERT>
# This sets a session cookie for subsequent requests.
ANKERCTL_API_KEY=REPLACE_WITH_SECURE_KEY


# ============================================================
# OPTIONAL – Server
# ============================================================

# Web server port (default: 4470)
#FLASK_PORT=4470

# Maximum upload size in megabytes (default: 2048)
#UPLOAD_MAX_MB=2048

# Upload speed to the printer in Mbit/s (values: 5, 10, 25, 50, 100; default: 10)
#UPLOAD_RATE_MBPS=10


# ============================================================
# OPTIONAL – UI
# ============================================================

# Show Pause/Resume/Stop buttons (experimental, may not be
# fully reliable). Set to any value to enable.
#ANKERCTL_PRINT_CONTROLS=1


# ============================================================
# OPTIONAL – Print History
# ============================================================

# Retention period for history entries in days (default: 90)
#PRINT_HISTORY_RETENTION_DAYS=90

# Maximum number of history entries (default: 500)
#PRINT_HISTORY_MAX_ENTRIES=500


# ============================================================
# OPTIONAL – Timelapse
# ============================================================
# Requires ffmpeg in the container and a mounted `/captures` volume.

# Enable timelapse capture (default: false)
#TIMELAPSE_ENABLED=false

# Seconds between snapshots (default: 30)
#TIMELAPSE_INTERVAL_SEC=30

# Maximum number of saved videos (default: 10)
#TIMELAPSE_MAX_VIDEOS=10

# Save videos persistently (default: true)
#TIMELAPSE_SAVE_PERSISTENT=true

# Directory for timelapse videos inside the container (default: /captures)
#TIMELAPSE_CAPTURES_DIR=/captures

# Light mode during timelapse capture (default: no light control)
#   snapshot – turn light on for each frame (wait 1.5s, snap, wait 1s, off)
#   session  – light on at capture start, off at capture end
#TIMELAPSE_LIGHT=snapshot


# ============================================================
# OPTIONAL – Home Assistant MQTT Discovery
# ============================================================
# Publishes printer status via MQTT Discovery in Home Assistant.
# Requires a reachable MQTT broker (e.g. Mosquitto).
#
# IMPORTANT: `HA_MQTT_PASSWORD` must be set if the broker requires
# authentication - an empty password results in rc=5 (Unauthorized).

#HA_MQTT_ENABLED=false
#HA_MQTT_HOST=localhost
#HA_MQTT_PORT=1883
#HA_MQTT_USER=
#HA_MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD
#HA_MQTT_DISCOVERY_PREFIX=homeassistant
#HA_MQTT_TOPIC_PREFIX=ankerctl


# ============================================================
# OPTIONAL – Apprise Notifications
# ============================================================
# Requires an external Apprise API server.
# See: https://github.com/caronc/apprise-api

#APPRISE_ENABLED=false
#APPRISE_SERVER_URL=http://apprise:8000
#APPRISE_KEY=ankerctl
#APPRISE_TAG=

# Event toggles
#APPRISE_EVENT_PRINT_STARTED=true
#APPRISE_EVENT_PRINT_FINISHED=true
#APPRISE_EVENT_PRINT_FAILED=true
#APPRISE_EVENT_GCODE_UPLOADED=true
#APPRISE_EVENT_PRINT_PROGRESS=true

# Progress notifications
#APPRISE_PROGRESS_INTERVAL=25
#APPRISE_PROGRESS_INCLUDE_IMAGE=false
#APPRISE_PROGRESS_MAX=0

# Snapshot settings (for image attachments in notifications)
#APPRISE_SNAPSHOT_QUALITY=hd
#APPRISE_SNAPSHOT_FALLBACK=true
#APPRISE_SNAPSHOT_LIGHT=false


# ============================================================
# OPTIONAL – Debug / Development
# ============================================================
# Shows the Debug menu in the web UI (red bug icon).
#ANKERCTL_DEV_MODE=false


# ============================================================
# LOGGING
# ============================================================
# Directory to write logs to (split by component: mqtt.log, web.log, etc.)
# If unset, logs only go to stdout/stderr.
#ANKERCTL_LOG_DIR=/logs
